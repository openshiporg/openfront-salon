  effectiveUntil  DateTime?
  supersedes      ConsultationTemplateVersion? @relation("ConsultationTemplateVersion_supersededBy")
  supersededBy    ConsultationTemplateVersion? @relation("ConsultationTemplateVersion_supersededBy", fields: [supersededById], references: [id])
  supersededById  String?                      @unique @map("supersededBy")
  submissions     ConsultationSubmission[]     @relation("ConsultationSubmission_templateVersion")
