model ConsultationTemplateVersion {
  id              String                       @id @default(cuid())
  template        FormTemplate?                @relation("ConsultationTemplateVersion_template", fields: [templateId], references: [id])
  templateId      String?                      @map("template")
  version         String                       @default("")
  titleSnapshot   String                       @default("")
  purposeSnapshot String                       @default("")
  questions       Json?                        @default("[]")
  questionsHash   String                       @default("")
  documentHash    String                       @default("")
  idempotencyKey  String                       @unique @default("")
