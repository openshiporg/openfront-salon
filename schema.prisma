model ConsultationSubmission {
  id                String                                 @id @default(cuid())
  client            User?                                  @relation("ConsultationSubmission_client", fields: [clientId], references: [id])
  clientId          String?                                @map("client")
  appointment       Appointment?                           @relation("ConsultationSubmission_appointment", fields: [appointmentId], references: [id])
  appointmentId     String?                                @map("appointment")
  templateVersion   ConsultationTemplateVersion?           @relation("ConsultationSubmission_templateVersion", fields: [templateVersionId], references: [id])
  templateVersionId String?                                @map("templateVersion")
  answers           Json?                                  @default("{}")
  questionsHash     String                                 @default("")
  answersHash       String                                 @default("")
  evidenceHash      String                                 @default("")
  signerName        String                                 @default("")
  signerRole        ConsultationSubmissionSignerRoleType
  guardianAuthority String                                 @default("")
  signatureEvidence String                                 @default("")
  actor             User?                                  @relation("ConsultationSubmission_actor", fields: [actorId], references: [id])
  actorId           String?                                @map("actor")
  actorAuthority    String                                 @default("")
  submittedAt       DateTime
  effectiveFrom     DateTime
  effectiveUntil    DateTime?
  supersedes        ConsultationSubmission?                @relation("ConsultationSubmission_supersededBy")
  supersededBy      ConsultationSubmission?                @relation("ConsultationSubmission_supersededBy", fields: [supersededById], references: [id])
  supersededById    String?                                @unique @map("supersededBy")
  idempotencyKey    String                                 @unique @default("")
  reviewStatus      ConsultationSubmissionReviewStatusType @default(submitted)
  reviews           ConsultationReview[]                   @relation("ConsultationReview_submission")
  createdAt         DateTime                               @default(now())
  updatedAt         DateTime                               @default(now()) @updatedAt

  @@index([clientId])
  @@index([appointmentId])
  @@index([templateVersionId])
  @@index([actorId])
}

